# Local API process
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000

# Local runtime storage (relative to backend/ when used by the backend)
DATA_DIR=../data
DATABASE_URL=sqlite:///../data/lab.sqlite
SIMULATION_MODE=local
LOG_LEVEL=INFO

# Browser origin permitted to reach the local API
CORS_ORIGINS=http://localhost:5173

# AWS settings intentionally begin in the dedicated AWS integration tasks.
